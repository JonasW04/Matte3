generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProgressStatus {
  NOT_ATTEMPTED
  SOLVED
  NOT_SOLVED
}

enum PracticeMode {
  TOPIC
  ADAPTIVE
  EXAM
}

enum PracticeProblemStatus {
  PENDING
  SOLVED
  NOT_SOLVED
}

model User {
  id           String                @id @default(cuid())
  name         String
  email        String                @unique
  passwordHash String
  role         Role                  @default(USER)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  sessions     AuthSession[]
  progress     UserProblemProgress[]
  practice     PracticeSession[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExamSource {
  id             String    @id @default(cuid())
  courseCode     String
  year           Int
  semester       String
  language       String
  examPdfUrl     String
  solutionPdfUrl String?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  problems       Problem[]

  @@unique([courseCode, year, semester, language])
  @@index([courseCode, year])
}

model Topic {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  week        Int?
  order       Int
  color       String
  description String     @db.Text
  subtopics   Subtopic[]
  problems    Problem[]

  @@index([order])
}

model Subtopic {
  id       String    @id @default(cuid())
  topicId  String
  slug     String
  name     String
  order    Int
  topic    Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  problems Problem[]

  @@unique([topicId, slug])
  @@index([slug])
}

model Problem {
  id                    String                   @id @default(cuid())
  sourceId              String
  problemNumber         String
  title                 String
  problemText           String                   @db.Text
  problemImageUrl       String?
  pdfPageRef            String?
  solutionText          String?                  @db.Text
  solutionPdfUrl        String?
  topicId               String
  subtopicId            String
  hiddenDifficultyScore Int
  estimatedMinutes      Int
  isSeedMock            Boolean                  @default(false)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  source                ExamSource               @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  topic                 Topic                    @relation(fields: [topicId], references: [id], onDelete: Restrict)
  subtopic              Subtopic                 @relation(fields: [subtopicId], references: [id], onDelete: Restrict)
  progress              UserProblemProgress[]
  sessionProblems       PracticeSessionProblem[]

  @@unique([sourceId, problemNumber])
  @@index([topicId])
  @@index([subtopicId])
}

model UserProblemProgress {
  userId           String
  problemId        String
  status           ProgressStatus @default(NOT_ATTEMPTED)
  attempts         Int            @default(0)
  lastAttemptedAt  DateTime?
  solvedAt         DateTime?
  solutionViewedAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem          Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@id([userId, problemId])
  @@index([status])
  @@index([lastAttemptedAt])
}

model PracticeSession {
  id               String                   @id @default(cuid())
  userId           String
  mode             PracticeMode
  startedAt        DateTime                 @default(now())
  completedAt      DateTime?
  timeLimitMinutes Int?
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problems         PracticeSessionProblem[]

  @@index([userId, startedAt])
  @@index([mode])
}

model PracticeSessionProblem {
  id        String                @id @default(cuid())
  sessionId String
  problemId String
  order     Int
  status    PracticeProblemStatus @default(PENDING)
  markedAt  DateTime?
  session   PracticeSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  problem   Problem               @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([sessionId, problemId])
  @@index([sessionId, order])
  @@index([problemId])
}
